# Example only. Inject secrets via protected service environment, never commit values.
FEISHU_MODE=production
FEISHU_LISTEN=127.0.0.1:8390
FEISHU_ORIGIN=https://api.huangjia.xin
FEISHU_DB=/var/lib/som-feishu/feishu.db
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional enterprise allowlist; leave empty per current scope. No enterprise-info permission needed.
FEISHU_TENANT_KEY=
FEISHU_PROOF_KEY=
SOM_ORIGIN=http://127.0.0.1:8330
FEISHU_BALANCE_READ_KEY=
FEISHU_BINDING_ENABLED=false
FEISHU_SENDING_ENABLED=false
FEISHU_SEND_USER_IDS=
FEISHU_POLL_SECONDS=120
# Core Sub2API ALSO needs FEISHU_PROOF_KEY + FEISHU_BALANCE_READ_KEY;
# FEISHU_ALLOWED_USER_IDS belongs to core only and is separate from send allowlist.
